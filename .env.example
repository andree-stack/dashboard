# Auth.js session encryption secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Required when running behind a proxy / non-standard host (e.g. most PaaS, sandboxes).
# Set to true, or set AUTH_URL to your canonical deployment URL instead.
AUTH_TRUST_HOST=true

# Demo credentials (single seeded user — swap lib/users.ts for a real DB in production)
DEMO_USER_EMAIL=admin@tamsaglobal.com
DEMO_USER_PASSWORD=philips2026
